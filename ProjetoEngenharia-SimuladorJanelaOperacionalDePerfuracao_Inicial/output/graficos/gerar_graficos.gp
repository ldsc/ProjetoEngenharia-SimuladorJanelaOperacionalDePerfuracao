set output 'output/graficos/01_perfil_sonico_tendencia.png'
set title 'Perfil Sonico e Tendencia Normal'
set xlabel 'Tempo de transito (us/ft)'
set ylabel 'Profundidade (m)'
set autoscale x
set yrange [*:*] reverse
set key bottom right
plot 'output/graficos/dados_graficos.csv' using 5:4 with lines lw 3 lc rgb '#1F4E79' title 'Delta t observado', \
     'output/graficos/dados_graficos.csv' using 6:4 with lines lw 3 dt 2 lc rgb '#F28E2B' title 'Delta t normal'
unset output
unset object

set output 'output/graficos/02_porosidade_densidade.png'
set multiplot layout 1,2 title 'Porosidade e Densidade x Profundidade'
set autoscale x
set yrange [*:*] reverse
set ylabel 'Profundidade (m)'
set xlabel 'Porosidade (fracao)'
set title 'Porosidade x Profundidade'
set key top right
plot 'output/graficos/dados_graficos.csv' using 7:4 with lines lw 3 lc rgb '#1F4E79' title 'Porosidade observada', \
     'output/graficos/dados_graficos.csv' using 8:4 with lines lw 3 dt 2 lc rgb '#F28E2B' title 'Porosidade normal'
unset ylabel
set xlabel 'Densidade bulk (lb/gal)'
set title 'Densidade x Profundidade'
unset key
plot 'output/graficos/dados_graficos.csv' using 10:4 with lines lw 3 lc rgb '#C00000' notitle
unset multiplot
unset output

set output 'output/graficos/03_tensao_sobrecarga.png'
set title 'Tensao de Sobrecarga x Profundidade'
set xlabel 'Tensao de sobrecarga sigma_v (psi)'
set ylabel 'Profundidade (m)'
set autoscale x
set yrange [*:*] reverse
unset key
plot 'output/graficos/dados_graficos.csv' using 11:4 with lines lw 3 lc rgb '#C00000'
unset output

